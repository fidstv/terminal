{
  "rules": {
    ".read": "auth != null || true",
    ".write": "auth != null || true",
    "corridas": {
      ".indexOn": ["oficina", "estatus", "horaSalida"]
    },
    "configuracion_audios": {
      "$oficinaId": {
        ".read": true,
        ".write": "auth != null || true",
        "desactivarEtiquetado": {
          ".validate": "newData.isBoolean()"
        },
        "desactivarAbordaje": {
          ".validate": "newData.isBoolean()"
        },
        "desactivarUltimaLlamada": {
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}