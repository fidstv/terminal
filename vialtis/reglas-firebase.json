{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      ".read": "auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.token.email_verified === true && auth.uid === $uid && !data.exists() && ((newData.child('empresa').val() === auth.uid && newData.child('rol').val() === 'admin') || (root.child('invitaciones').child(newData.child('inv').val()).child('empresa').val() === newData.child('empresa').val() && root.child('invitaciones').child(newData.child('inv').val()).child('rol').val() === newData.child('rol').val() && root.child('invitaciones').child(newData.child('inv').val()).child('exp').val() > now))) || (auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true) || (auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('empresa').val() === data.child('empresa').val() && !newData.exists() && $uid !== data.child('empresa').val())",
        ".validate": "newData.hasChildren(['empresa','rol','email']) && (newData.child('rol').val() === 'admin' || newData.child('rol').val() === 'taquillero') && newData.child('email').isString() && newData.child('empresa').isString()",
        "inv": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 120"
        },
        "empresa": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        }
      }
    },
    "invitaciones": {
      "$code": {
        ".read": true,
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && (!data.exists() || data.child('empresa').val() === root.child('usuarios').child(auth.uid).child('empresa').val()) && (!newData.exists() || newData.child('empresa').val() === root.child('usuarios').child(auth.uid).child('empresa').val())) || (auth != null && !newData.exists() && root.child('usuarios').child(auth.uid).child('inv').val() === $code)",
        ".validate": "newData.hasChildren(['empresa','rol','exp']) && (newData.child('rol').val() === 'admin' || newData.child('rol').val() === 'taquillero') && newData.child('exp').isNumber() && newData.child('exp').val() < now + 1209600000 && $code.matches(/^[A-Za-z0-9]{8,24}$/)"
      }
    },
    "equipos": {
      "$e": {
        ".read": "(auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin') || (auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true)",
        "$uid": {
          ".write": "(auth != null && auth.token.email_verified === true && auth.uid === $uid && !data.exists() && (auth.uid === $e || (root.child('invitaciones').child(newData.child('inv').val()).child('empresa').val() === $e && root.child('invitaciones').child(newData.child('inv').val()).child('rol').val() === newData.child('rol').val() && root.child('invitaciones').child(newData.child('inv').val()).child('exp').val() > now))) || (auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && $uid !== $e) || (auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true)",
          ".validate": "newData.hasChildren(['email','rol']) && (newData.child('rol').val() === 'admin' || newData.child('rol').val() === 'taquillero')"
        }
      }
    },
    "empresas": {
      ".read": "auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true",
      "$e": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true",
        "meta": {
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $e && !data.exists()",
          ".validate": "newData.hasChildren(['nombre','plan','creada']) && newData.child('nombre').isString() && newData.child('nombre').val().length <= 60 && (newData.child('plan').val() === 'gratis' || (auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true)) && newData.child('creada').isNumber()",
          "nombre": {
            ".write": "auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('empresas').child($e).child('meta').child('suspendida').val() !== true",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          }
        },
        "ajustes": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('empresas').child($e).child('meta').child('suspendida').val() !== true",
          "marca": {
            "logo": {
              ".validate": "newData.isString() && newData.val().length <= 200000 && newData.val().beginsWith('data:image/')"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "nombre": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 24"
            }
          }
        },
        "rutas": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('empresas').child($e).child('meta').child('suspendida').val() !== true",
          "$r": {
            ".validate": "newData.hasChildren(['hora','destino']) && $r.matches(/^[A-Za-z0-9_-]{1,40}$/)",
            "hora": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
            },
            "destino": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 60"
            },
            "escalas": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
            },
            "dias": {
              ".validate": "newData.isString() && newData.val().matches(/^[01]{7}$/)"
            },
            "activa": {
              ".validate": "newData.isBoolean()"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "deps": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('empresas').child($e).child('meta').child('suspendida').val() !== true",
          "$id": {
            ".validate": "newData.hasChildren(['time','destination','day']) && $id.matches(/^[A-Za-z0-9_-]{1,60}$/)",
            "time": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
            },
            "orig": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
            },
            "day": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "destination": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "scales": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
            },
            "bus": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 10"
            },
            "gate": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 30"
            },
            "motivo": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
            },
            "ruta": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
            },
            "status": {
              ".validate": "newData.val() === 'ETIQUETANDO' || newData.val() === 'ABORDAJE' || newData.val() === 'ULTIMA' || newData.val() === 'SALIDO'"
            },
            "delay": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "urgent": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('empresas').child($e).child('meta').child('suspendida').val() !== true",
          ".validate": "newData.hasChildren(['text','ts'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$otro": {
            ".validate": false
          }
        },
        "plantillas": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('empresas').child($e).child('meta').child('suspendida').val() !== true",
          "$i": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140 && $i.matches(/^[0-9]{1,2}$/)"
          }
        },
        "voz_cmd": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e && root.child('empresas').child($e).child('meta').child('suspendida').val() !== true",
          ".validate": "newData.hasChildren(['mode','ts']) && (newData.child('mode').val() === 'etiq' || newData.child('mode').val() === 'abord' || newData.child('mode').val() === 'ultima' || newData.child('mode').val() === 'retraso')"
        },
        "panico": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e",
          ".validate": "newData.isNumber()"
        },
        "tvs": {
          "$id": {
            ".write": "(newData.exists() && root.child('empresas').child($e).child('meta').exists()) || (auth != null && root.child('usuarios').child(auth.uid).child('empresa').val() === $e)",
            ".validate": "newData.hasChildren(['ts']) && $id.matches(/^[A-Za-z0-9_-]{4,40}$/)",
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "view": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 10"
            },
            "ver": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 10"
            },
            "audio": {
              ".validate": "newData.isBoolean()"
            },
            "$otro": {
              ".validate": false
            }
          }
        }
      }
    },
    "plataforma": {
      "empresas": {
        ".read": "auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true",
        "$e": {
          ".write": "(auth != null && auth.token.email_verified === true && auth.uid === $e && !data.exists()) || (auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true)",
          ".validate": "newData.hasChildren(['nombre','plan','creada']) && (newData.child('plan').val() === 'gratis' || (auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true))",
          "nombre": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 60"
          }
        }
      }
    },
    "pairing": {
      "$code": {
        ".read": true,
        ".validate": "$code.matches(/^[0-9]{6}$/)",
        "info": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['ts'])",
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 60000"
          },
          "$otro": {
            ".validate": false
          }
        },
        "assigned": {
          ".write": "auth != null && auth.token.email_verified === true && !data.exists() && root.child('pairing').child($code).child('info').exists() && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && newData.child('e').val() === root.child('usuarios').child(auth.uid).child('empresa').val() && root.child('empresas').child(newData.child('e').val()).child('meta').child('suspendida').val() !== true",
          ".validate": "newData.hasChildren(['vista','ts','e'])",
          "vista": {
            ".validate": "newData.val() === 'tv' || newData.val() === 'anden'"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "e": {
            ".validate": "newData.isString()"
          },
          "$otro": {
            ".validate": false
          }
        }
      },
      ".write": "(auth != null && auth.token.email === 'vialtis@gmail.com' && auth.token.email_verified === true)"
    }
  }
}
